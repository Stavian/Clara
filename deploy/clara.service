[Unit]
Description=Clara AI Assistant (Node)
Documentation=https://github.com/Stavian/Clara
After=network-online.target local-fs.target
Wants=network-online.target
RequiresMountsFor=/mnt/storage

[Service]
Type=simple
User=clara
Group=clara
WorkingDirectory=/opt/clara
EnvironmentFile=/opt/clara/.env

ExecStart=/usr/bin/node /opt/clara/dist/entry.js gateway run

Restart=always
RestartSec=10
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=clara

[Install]
WantedBy=multi-user.target
