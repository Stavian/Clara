# ============================================================
# Clara AI Assistant v2 — Environment Configuration
# Copy this file to .env and fill in your values.
# Config file lives at ~/.clara/config.json5
# These env vars override config file values.
# ============================================================

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=huihui_ai/qwen3-abliterated:14b

# --- Web server ---
HOST=127.0.0.1
PORT=8080

# --- Authentication ---
# Leave WEB_PASSWORD empty to disable auth
WEB_PASSWORD=
JWT_SECRET=

# --- Stable Diffusion Forge (optional) ---
SD_ENABLED=false
# SD_FORGE_DIR=/mnt/storage/stable-diffusion-webui-forge
# SD_API_URL=http://127.0.0.1:7860

# --- Discord bot (optional) ---
DISCORD_BOT_TOKEN=
DISCORD_OWNER_ID=

# --- External LLM providers (optional) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Google Calendar (optional) ---
GOOGLE_CALENDAR_ID=primary
