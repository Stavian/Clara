{
  "name": "clara",
  "version": "2.0.0",
  "description": "Clara AI Assistant - TypeScript rewrite on OpenClaw architecture",
  "type": "module",
  "bin": {
    "clara": "./dist/entry.js"
  },
  "scripts": {
    "dev": "tsx src/entry.ts",
    "dev:gw": "tsx src/entry.ts gateway run",
    "build": "tsdown",
    "start": "node dist/entry.js gateway run",
    "lint": "oxlint src",
    "test": "vitest run",
    "clara": "tsx src/entry.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^9.0.0",
    "@fastify/websocket": "^11.2.0",
    "@sinclair/typebox": "^0.34.48",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.6.2",
    "commander": "^14.0.3",
    "fastify": "^5.8.1",
    "jiti": "^2.6.1",
    "js-yaml": "^4.1.1",
    "json5": "^2.2.3",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.2.1",
    "openai": "^4.93.0",
    "sqlite-vec": "^0.1.7-alpha.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.14.1",
    "@types/node-cron": "^3.0.11",
    "oxlint": "^1.51.0",
    "tsdown": "^0.21.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
